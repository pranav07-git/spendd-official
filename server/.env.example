# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Required: signs sign-in tokens (JWT). At least 32 random characters, e.g. `openssl rand -hex 32`.
# Changing it signs everyone out.
JWT_SECRET=
PORT=8787
# 127.0.0.1 (default) = this machine only; 0.0.0.0 when deployed behind HTTPS.
HOST=
# 1 when behind a reverse proxy (Caddy, a load balancer), so rate limits see the real client address.
TRUST_PROXY=
# A header your host sets to the client's address, which callers can't forge. On Render: cf-connecting-ip.
CLIENT_IP_HEADER=
# Where accounts (users.json) and the merchant cache are kept. Default: server/data.
DATA_DIR=
# Pings <url>/health every 10 min so free hosts don't sleep. On Render it uses RENDER_EXTERNAL_URL
# automatically; set KEEP_ALIVE=0 to turn that off.
KEEP_ALIVE_URL=
# Optional: which Gemini model to use (default gemini-3.5-flash-lite).
GEMINI_MODEL=
