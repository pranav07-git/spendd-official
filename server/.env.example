# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Required: the app sends this in the x-spendd-token header. Any long random string, e.g. `openssl rand -hex 32`.
SPENDD_APP_TOKEN=
PORT=8787
# 127.0.0.1 (default) = this machine only; 0.0.0.0 when deployed behind HTTPS.
HOST=
# Optional: which Gemini model to use (default gemini-3.5-flash-lite).
GEMINI_MODEL=
